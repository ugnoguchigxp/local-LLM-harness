{
  "name": "local-ai-runtime-manager",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter @larm/daemon dev",
    "start": "bun run --filter @larm/daemon start",
    "docs": "bun x --bun --no-install spec-html ./specs --markdown-lang ja",
    "docs:fix": "bun x --bun --no-install spec-html fix ./specs --write",
    "docs:format": "bun x --bun --no-install spec-html format ./specs --write",
    "docs:check": "bun x --bun --no-install spec-html check ./specs --warnings-as-errors",
    "docs:check:fix": "bun x --bun --no-install spec-html check ./specs --fix --warnings-as-errors",
    "typecheck": "tsc --noEmit",
    "test": "bun test apps packages",
    "check:source-only": "bash scripts/check-source-only.sh",
    "check:operations": "bash scripts/check-operations.sh",
    "test:deployment": "bash deploy/gnosis/scripts/install-services.test.sh && bash deploy/gnosis/scripts/release-larm.test.sh",
    "check": "bun run check:source-only && bun run check:operations && bun run docs:check && bun run typecheck && bun run test && bun run test:deployment"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "spec-html": "0.1.6",
    "typescript": "5.9.2"
  }
}
