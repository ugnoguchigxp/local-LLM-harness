// LARM may start and stop only its demand-driven media workers.
polkit.addRule(function(action, subject) {
    if (subject.user === "ugnoguchi"
        && action.id === "org.freedesktop.systemd1.manage-units"
        && ["larm-image-qwen21.service", "larm-music-ace-step.service"].indexOf(action.lookup("unit")) !== -1
        && ["start", "stop"].indexOf(action.lookup("verb")) !== -1) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
