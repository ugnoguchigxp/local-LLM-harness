polkit.addRule(function(action, subject) {
  if (action.id === "org.freedesktop.systemd1.manage-units" && subject.user === "__LARM_DAEMON_USER__") {
    if (action.lookup("unit") === "larm-local-service-docling-desk.service" &&
        (action.lookup("verb") === "start" || action.lookup("verb") === "stop")) {
      return polkit.Result.YES;
    }
    if (action.lookup("unit") === "larm-local-service-docling-desk-stop.service" && action.lookup("verb") === "start") {
      return polkit.Result.YES;
    }
  }
});
