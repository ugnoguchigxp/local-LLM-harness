// Permit the unprivileged LARM daemon to start and stop only the declared
// preferred systemd provider. Resident providers remain outside this rule.
polkit.addRule(function(action, subject) {
    if (
        subject.user === "ugnoguchi"
        && action.id === "org.freedesktop.systemd1.manage-units"
        && action.lookup("unit") === "qwen-tts.service"
        && ["start", "stop"].indexOf(action.lookup("verb")) !== -1
    ) {
        return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;
});
