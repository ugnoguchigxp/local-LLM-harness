+    bool larm_kv_resize(uint32_t tokens) {
+        const auto before = llama_larm_kv_capacity(ctx_tgt);
+        if (before == tokens) return true;
+        const auto started = ggml_time_us();
+        const bool ok = llama_larm_resize_kv(ctx_tgt, tokens);
+        larm_kv_last_ms = double(ggml_time_us() - started) / 1000.0;
+        larm_kv_max_ms = std::max(larm_kv_max_ms, larm_kv_last_ms);
+        if (!ok) ++larm_kv_failures;
+        else if (tokens > before) ++larm_kv_grows;
+        else ++larm_kv_shrinks;
+        SRV_INF("larm_kv event=%s before=%u after=%u ms=%.3f\n", ok ? (tokens > before ? "grow" : "shrink") : "failure",
+            before, llama_larm_kv_capacity(ctx_tgt), larm_kv_last_ms);
+        return ok;
+    }
+    uint32_t larm_kv_needed(int pending_slot = -1, size_t completions = 1) const {
