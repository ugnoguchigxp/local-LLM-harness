+
+bool llama_context::larm_resize_kv(uint32_t tokens) {
+    auto * hybrid = dynamic_cast<llama_memory_hybrid *>(memory.get());
+    if (!hybrid || !cparams.kv_unified || tokens == 0 || tokens > cparams.n_ctx || tokens % 256) return false;
+    if (tokens == larm_kv_capacity()) return true;
+    synchronize();
+    std::unique_ptr<llama_kv_cache> previous;
+    try {
+        auto next = hybrid->get_mem_attn()->larm_resized(tokens);
+        previous = hybrid->larm_replace_attn(std::move(next));
+        // Both cached graphs and scheduler views refer to the old tensors.
+        // Rebuild while the previous cache is still alive for rollback.
+        sched_need_reserve = true;
+        sched_reserve();
+        synchronize();
+        return true;
+    } catch (const std::exception & error) {
+        LLAMA_LOG_ERROR("larm_kv resize_failed: %s\n", error.what());
+        if (previous) {
+            auto failed = hybrid->larm_replace_attn(std::move(previous));
+            // Free views and the failed allocation before rebuilding the old
+            // scheduler, especially when the new reserve failed due to OOM.
+            if (sched) ggml_backend_sched_synchronize(sched.get());
+            gf_res_prev.reset();
+            gf_res_reserve.reset();
+            sched.reset();
+            failed.reset();
+            sched_need_reserve = true;
+            try { sched_reserve(); synchronize(); }
+            catch (...) { GGML_ABORT("on-demand KV rollback failed"); }
+        }
+        return false;
+    }
+}
+extern "C" bool llama_larm_resize_kv(llama_context * ctx, uint32_t tokens);
+extern "C" uint32_t llama_larm_kv_capacity(const llama_context * ctx);
+bool llama_larm_resize_kv(llama_context * ctx, uint32_t tokens) { return ctx && ctx->larm_resize_kv(tokens); }
+uint32_t llama_larm_kv_capacity(const llama_context * ctx) { return ctx ? ctx->larm_kv_capacity() : 0; }
