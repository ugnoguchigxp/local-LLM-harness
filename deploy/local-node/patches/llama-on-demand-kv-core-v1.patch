+// Build an independent cache before touching the live one. Recurrent state stays
+// in the hybrid memory module; sequence snapshots here contain attention KV only.
+std::unique_ptr<llama_kv_cache> llama_kv_cache::larm_resized(uint32_t tokens) const {
+    if (!tokens || tokens % n_pad || n_stream != 1 || v_trans || n_swa != 0 || layers.empty()
+        || map_layer_ids.size() != layers.size() || hparams.no_alloc) {
+        throw std::runtime_error("unsupported on-demand KV memory");
+    }
+    auto buft = ggml_backend_buffer_get_type(layers.front().k->buffer);
+    for (const auto & layer : layers) {
+        if (!layer.v || layer.k->type != type_k() || layer.v->type != type_v()
+            || ggml_backend_buffer_get_type(layer.k->buffer) != buft
+            || ggml_backend_buffer_get_type(layer.v->buffer) != buft) {
+            throw std::runtime_error("unsupported mixed on-demand KV buffers");
+        }
+    }
+    const auto included = map_layer_ids;
+    auto next = std::make_unique<llama_kv_cache>(model, hparams, type_k(), type_v(), v_trans,
+        !ggml_backend_buft_is_host(buft), true, tokens, n_seq_max, n_pad, n_swa, swa_type,
+        [included](int32_t il) { return included.count(il) != 0; }, nullptr);
+    if (ggml_backend_buffer_get_type(next->layers.front().k->buffer) != buft) {
+        throw std::runtime_error("on-demand KV backend changed");
+    }
+    struct transfer : llama_io_write_i, llama_io_read_i {
+        std::vector<uint8_t> data;
+        size_t offset = 0;
+        size_t n_bytes() override { return offset; }
+        void write(const void * src, size_t size) override {
+            if (size > 2ULL*1024*1024*1024 - data.size()) throw std::runtime_error("on-demand KV transfer budget");
+            const size_t start = data.size(); data.resize(start + size);
+            if (size) memcpy(data.data() + start, src, size);
+            offset += size;
+        }
+        void write_tensor(ggml_tensor * t, size_t start, size_t size) override {
+            if (size > 2ULL*1024*1024*1024 - data.size()) throw std::runtime_error("on-demand KV transfer budget");
+            const size_t old = data.size(); data.resize(old + size);
+            if (size) ggml_backend_tensor_get(t, data.data() + old, start, size);
+            offset += size;
+        }
+        void read(void * dst, size_t size) override {
+            if (offset > data.size() || size > data.size() - offset) throw std::runtime_error("on-demand KV transfer truncated");
+            if (size) memcpy(dst, data.data() + offset, size);
+            offset += size;
+        }
+        void read_tensor(ggml_tensor * t, size_t start, size_t size) override {
+            if (offset > data.size() || size > data.size() - offset) throw std::runtime_error("on-demand KV transfer truncated");
+            if (size) ggml_backend_tensor_set(t, data.data() + offset, start, size);
+            offset += size;
+        }
+    };
+    for (uint32_t seq = 0; seq < n_seq_max; ++seq) {
+        if (seq_pos_max(seq) < 0) continue;
+        transfer io;
+        state_write(io, seq);
+        io.offset = 0;
+        next->state_read(io, seq);
+        if (io.offset != io.data.size()) throw std::runtime_error("on-demand KV transfer size mismatch");
+    }
+    return next;
+}
