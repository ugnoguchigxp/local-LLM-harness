+static bool larm_cache_authorized(const server_http_req & req) {
+    const auto * value = larm_retention_header(req.headers, "x-larm-cache-key");
+    const auto & key = larm_cache_key();
+    if (key.size() != 64 || !value || value->size() != key.size()) return false;
+    unsigned int difference = 0;
+    for (size_t i = 0; i < key.size(); ++i) difference |= (unsigned char) key[i] ^ (unsigned char) (*value)[i];
+    return difference == 0;
