+        const auto j = json::parse(text);
+        if (j.value("protocol", "") != "larm-prompt-cache.v1" || j.size() != 10) throw std::runtime_error("invalid retention policy");
+        auto number = [&](const char * name) -> uint64_t {
+            if (!j.at(name).is_number_integer() || j.at(name).get<int64_t>() <= 0) throw std::runtime_error("invalid retention bound");
+            return j.at(name).get<uint64_t>();
+        };
+        p.max_bytes = number("maxBytes"); p.owner_bytes = number("principalMaxBytes");
+        p.entry_bytes = number("entryMaxBytes"); p.staging_bytes = number("stagingMaxBytes"); p.metadata_bytes = number("metadataMaxBytes");
+        p.max_entries = number("maxEntries"); p.owner_entries = number("principalMaxEntries");
+        p.idle_ms = number("idleTtlMs"); p.age_ms = number("maxAgeMs");
+    }
+    if (p.entry_bytes > p.owner_bytes || p.owner_bytes > p.max_bytes || p.entry_bytes > p.staging_bytes
+        || p.owner_entries > p.max_entries || p.max_entries > 4096 || p.idle_ms < 1000 || p.idle_ms > 3600000
+        || p.age_ms < p.idle_ms || p.age_ms > 86400000) throw std::runtime_error("inconsistent retention policy");
+    return p;
