+inline bool larm_text_tokens(const server_tokens & tokens) {
+    for (size_t i = 0; i < tokens.size(); ++i) if (tokens[i] == LLAMA_TOKEN_NULL) return false;
+    return true;
+}
+inline bool larm_same_snapshot(const server_prompt & a, const server_prompt & b) {
+    if (!larm_retention_policy::same(a.retention, b.retention) || a.tokens.size() != b.tokens.size()
+        || a.tokens.get_common_prefix(b.tokens) != b.tokens.size() || a.checkpoints.size() != b.checkpoints.size()) return false;
+    auto other = b.checkpoints.begin();
+    for (const auto & checkpoint : a.checkpoints) {
+        if (checkpoint.n_tokens != other->n_tokens || checkpoint.pos_min != other->pos_min
+            || checkpoint.pos_max != other->pos_max || checkpoint.size() != other->size()) return false;
+        ++other;
+    }
+    return true;
+}
+inline size_t larm_effective_prefix(const server_prompt & p, const server_tokens & next, int swa) {
+    const size_t lcp = p.tokens.get_common_prefix(next);
+    if (lcp == 0 || !larm_text_tokens(p.tokens) || !larm_text_tokens(next)) return 0;
+    const auto pos = p.tokens.pos_next(lcp);
+    const auto threshold = std::max<int64_t>(0, pos - swa - (lcp < next.size() ? 0 : 1));
+    if (p.retention.memory_floor < threshold) return lcp;
+    for (auto it = p.checkpoints.rbegin(); it != p.checkpoints.rend(); ++it) {
+        if (it->pos_max > pos || (it->pos_min >= threshold && it->pos_min != 0)) continue;
+        const auto restored = std::min<int64_t>(pos, std::max(it->pos_min + 1, it->pos_max));
+        return std::min(p.tokens.size_up_to_pos(restored), (size_t) it->n_tokens);
+    }
+    return 0;
+}
