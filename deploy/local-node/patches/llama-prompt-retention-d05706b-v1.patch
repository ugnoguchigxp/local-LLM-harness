+static const std::string & larm_cache_key() {
+    static const std::string key = getenv("LARM_PROMPT_CACHE_KEY") ? getenv("LARM_PROMPT_CACHE_KEY") : "";
+    return key;
+}
+static bool larm_cache_authorized(const server_http_req & req) {
+    const auto * value = larm_retention_header(req.headers, "x-larm-cache-key");
+    const auto & key = larm_cache_key();
+    if (key.size() != 64 || !value || value->size() != key.size()) return false;
+    unsigned int difference = 0;
+    for (size_t i = 0; i < key.size(); ++i) difference |= (unsigned char) key[i] ^ (unsigned char) (*value)[i];
+    return difference == 0;
+}
+static larm_retention_policy larm_cache_policy() {
+    larm_retention_policy p;
+    p.enabled = !larm_cache_key().empty();
+    if (p.enabled && !larm_retention_policy::opaque(larm_cache_key())) throw std::runtime_error("invalid private cache key");
+    const char * text = getenv("LARM_PROMPT_CACHE_POLICY");
+    if (text && *text) {
+        const auto j = json::parse(text);
+        if (j.value("protocol", "") != "larm-prompt-cache.v1" || j.size() != 10) throw std::runtime_error("invalid retention policy");
+        auto number = [&](const char * name) -> uint64_t {
+            if (!j.at(name).is_number_integer() || j.at(name).get<int64_t>() <= 0) throw std::runtime_error("invalid retention bound");
+            return j.at(name).get<uint64_t>();
+        };
+        p.max_bytes = number("maxBytes"); p.owner_bytes = number("principalMaxBytes");
+        p.entry_bytes = number("entryMaxBytes"); p.staging_bytes = number("stagingMaxBytes"); p.metadata_bytes = number("metadataMaxBytes");
+        p.max_entries = number("maxEntries"); p.owner_entries = number("principalMaxEntries");
+        p.idle_ms = number("idleTtlMs"); p.age_ms = number("maxAgeMs");
+    }
+    if (p.entry_bytes > p.owner_bytes || p.owner_bytes > p.max_bytes || p.entry_bytes > p.staging_bytes
+        || p.owner_entries > p.max_entries || p.max_entries > 4096 || p.idle_ms < 1000 || p.idle_ms > 3600000
+        || p.age_ms < p.idle_ms || p.age_ms > 86400000) throw std::runtime_error("inconsistent retention policy");
+    return p;
+}
+static json larm_cache_properties() {
+    const auto p = larm_cache_policy();
+    return {{"enabled", p.enabled}, {"text_only", true}, {"speculative", false}, {"lora", false}, {"policy", {
+        {"protocol", "larm-prompt-cache.v1"}, {"maxBytes", p.max_bytes}, {"principalMaxBytes", p.owner_bytes},
+        {"entryMaxBytes", p.entry_bytes}, {"stagingMaxBytes", p.staging_bytes}, {"metadataMaxBytes", p.metadata_bytes},
+        {"maxEntries", p.max_entries}, {"principalMaxEntries", p.owner_entries}, {"idleTtlMs", p.idle_ms}, {"maxAgeMs", p.age_ms}}}};
+}
+static larm_cache_record larm_cache_context(const server_http_req & req) {
+    larm_cache_record r;
+    if (!larm_cache_authorized(req)) return r; // Maintenance or unscoped consumer: no retained state.
+    const auto * value = larm_retention_header(req.headers, "x-larm-cache-context");
+    if (!value || value->size() > 1024) throw std::runtime_error("invalid cache context");
+    const auto j = json::parse(*value);
+    if (j.size() != 5) throw std::runtime_error("invalid cache context");
+    r.owner = j.at("owner"); r.scope = j.at("scope"); r.instance = j.at("instance"); r.correlation = j.at("correlation");
+    if (!larm_retention_policy::opaque(r.owner) || !larm_retention_policy::opaque(r.scope)
+        || !larm_retention_policy::opaque(r.instance) || !larm_retention_policy::opaque(r.correlation)
+        || !j.at("leaseMs").is_number_integer()) throw std::runtime_error("invalid cache context");
+    const auto lease = j.at("leaseMs").get<int64_t>();
+    if (lease < 1 || lease > 300000) throw std::runtime_error("invalid cache lease");
+    r.created = r.used = larm_retention_policy::now(); r.lease_until = r.used + lease;
+    return r;
+}
