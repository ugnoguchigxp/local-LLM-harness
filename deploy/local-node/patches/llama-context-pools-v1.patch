+static const larm_context_layout & larm_context_pools() {
+    static const auto pools = larm_context_layout::parse(
+        getenv("LARM_CONTEXT_SLOTS") ? getenv("LARM_CONTEXT_SLOTS") : "",
+        getenv("LARM_CONTEXT_DEFAULT_TOKENS") ? getenv("LARM_CONTEXT_DEFAULT_TOKENS") : "");
+    return pools;
+}
+static int32_t larm_request_context_tokens(const server_http_req & req) {
+    const auto & pools = larm_context_pools();
+    if (!pools.enabled()) return 0;
+    const auto * text = larm_retention_header(req.headers, "x-larm-context-tokens");
+    if (!text || !larm_cache_authorized(req)) return pools.default_tokens;
+    const int32_t tokens = larm_context_layout::number(*text);
+    if (!pools.accepts(tokens)) throw std::runtime_error("unconfigured context pool");
+    return tokens;
 }
