[Unit]
Description=local-LLM-harness on-demand Qwen worker
[Service]
Type=simple
User=ugnoguchi
Group=ugnoguchi
WorkingDirectory=/srv/ai/apps
Environment=HOME=/srv/ai/cache
Environment=XDG_CACHE_HOME=/srv/ai/cache
ExecStart=/srv/ai/apps/llama-swap/llama-swap --config /var/lib/larm/provider-config/llama-swap.yaml --watch-config --listen 127.0.0.1:8083
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=60
KillMode=control-group
LimitMEMLOCK=infinity
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/ai/cache /srv/ai/logs
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
