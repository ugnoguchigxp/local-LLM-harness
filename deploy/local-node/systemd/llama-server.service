[Unit]
Description=Ornith 1.5 35B Primary LLM Provider (ROCmFP4 + Vulkan MTP)

[Service]
Type=simple
User=ugnoguchi
Group=ugnoguchi
WorkingDirectory=/srv/ai/apps/q38rocm
Environment=HOME=/srv/ai/cache
Environment=XDG_CACHE_HOME=/srv/ai/cache
ExecStart=/srv/ai/apps/q38rocm/engine/bin/llama-server \
  -m /srv/ai/models/halofpx/ornith-1.5-35b/Ornith-1.5-35B-A3B-ROCmFP4.gguf \
  -dev Vulkan0 \
  -ngl 999 \
  --fit off \
  --flash-attn on \
  --host 127.0.0.1 \
  --port 8080 \
  --ctx-size 131072 \
  --parallel 1 \
  --batch-size 2048 \
  --ubatch-size 1024 \
  --threads 16 \
  --poll 100 \
  --cache-type-k q8_0 \
  --cache-type-v q8_0 \
  --no-mmap \
  --cont-batching \
  --kv-unified \
  --reasoning auto \
  --temp 0.6 \
  --top-p 0.95 \
  --top-k 20 \
  --jinja \
  --context-shift \
  --spec-type draft-mtp \
  --spec-draft-n-max 4 \
  --spec-draft-p-min 0.6 \
  -ctxcp 0 \
  -cram 0 \
  --no-cache-prompt \
  --no-cache-idle-slots \
  --slot-save-path /srv/ai/cache/personal-state-slots \
  --metrics \
  --no-webui
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=30
KillSignal=SIGINT
LimitNOFILE=1048576
LimitMEMLOCK=infinity
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/ai/models /srv/ai/apps/q38rocm
ReadWritePaths=/srv/ai/cache /srv/ai/logs
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
