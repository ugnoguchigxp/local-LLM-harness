[Unit]
Description=Qwen3.8 27B Primary LLM Provider (ROCmFP4 FAST + Vulkan MTP)

[Service]
Type=simple
User=ugnoguchi
Group=ugnoguchi
WorkingDirectory=/srv/ai/apps/q38rocm
Environment=HOME=/srv/ai/cache
Environment=XDG_CACHE_HOME=/srv/ai/cache
Environment=MTP=1
Environment=STRICT_MTP=1
Environment=REASONING_BUDGET=-1
Environment=SLOTS=1
Environment=LLAMA_SERVER_BIN=/srv/ai/apps/q38rocm/engine/bin/llama-server-larm-native
Environment=LARM_NATIVE_ENGINE_SOCKET=/run/larm-native-qwen/engine.sock
RuntimeDirectory=larm-native-qwen
RuntimeDirectoryMode=0700
ExecStart=/srv/ai/apps/q38rocm/run_server.sh \
  /srv/ai/models/qwen38-rocmfp4/Qwen3.8-27B-ROCmFP4-FAST.gguf \
  --profile speed \
  --host 127.0.0.1 \
  --port 8080 \
  --ctx 262144 \
  --draft-n 2 \
  --draft-p 0.0 \
  --batch 2048 \
  --ubatch 1024 \
  --kv-k q8_0 \
  --kv-v q8_0 \
  --temp 0.2 \
  --repeat-penalty 1.0 \
  --reasoning auto \
  --slot-save-path /srv/ai/cache/personal-state-slots \
  --metrics \
  --no-webui
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=30
KillSignal=SIGINT
LimitNOFILE=1048576
LimitMEMLOCK=infinity
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/ai/models /srv/ai/apps/q38rocm
ReadWritePaths=/srv/ai/cache /srv/ai/logs
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
