[Unit]
Description=Qwen3.8 27B Primary LLM Provider (ROCmFP4 FAST + Vulkan MTP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ugnoguchi
Group=ugnoguchi
WorkingDirectory=/srv/ai/apps/q38rocm
Environment=HOME=/srv/ai/cache
Environment=XDG_CACHE_HOME=/srv/ai/cache
Environment=PROFILE=speed
Environment=CTX=262144
Environment=MTP=1
Environment=DRAFT_N=2
Environment=DRAFT_P=0.0
Environment=KV_K=q8_0
Environment=KV_V=turbo4
Environment=REASONING=auto
Environment=REASONING_BUDGET=-1
Environment=TEMP=0.2
Environment=REPEAT_PENALTY=1.0
Environment=SLOTS=1
Environment=BATCH_SIZE=2048
Environment=UBATCH_SIZE=2048
Environment=LLAMA_SERVER_BIN=/srv/ai/apps/q38rocm/engine/bin/llama-server-larm-native
Environment=LARM_NATIVE_ENGINE_SOCKET=/run/larm-native-qwen/engine.sock
RuntimeDirectory=larm-native-qwen
RuntimeDirectoryMode=0700
ExecStart=/srv/ai/apps/q38rocm/run_server.sh \
  /srv/ai/models/qwen38-rocmfp4/Qwen3.8-27B-ROCmFP4-FAST.gguf \
  --profile speed \
  --host 127.0.0.1 \
  --port 8080 \
  --ctx 262144 \
  --draft-n 2 \
  --draft-p 0.0 \
  --batch 2048 \
  --ubatch 2048 \
  --kv-k q8_0 \
  --kv-v turbo4 \
  --temp 0.2 \
  --repeat-penalty 1.0 \
  --reasoning auto \
  --metrics \
  --no-webui
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=30
KillSignal=SIGINT
LimitNOFILE=1048576
LimitMEMLOCK=infinity
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/ai/models /srv/ai/apps/q38rocm
ReadWritePaths=/srv/ai/cache /srv/ai/logs
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
