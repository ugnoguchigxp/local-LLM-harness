[Unit]
Description=LARM KittenTTS Nano FP32 English CPU speech provider
After=local-fs.target

[Service]
Type=simple
User=ugnoguchi
Group=ugnoguchi
WorkingDirectory=/srv/ai/apps/larm-current/apps/kittentts-tts
Environment=HOME=/srv/ai/cache
Environment=XDG_CACHE_HOME=/srv/ai/cache
Environment=KITTENTTS_MODEL_ROOT=/srv/ai/models/kittentts/fp32
Environment=KITTENTTS_THREADS=4
Environment=OMP_NUM_THREADS=4
Environment=OPENBLAS_NUM_THREADS=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/ai/apps/kittentts-runtime/.venv/bin/uvicorn kitten_api:app --host 127.0.0.1 --port 8088 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
LimitNOFILE=65535
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/srv/ai/cache /srv/ai/logs
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
