[Unit]
Description=Prune expired and capacity-pressured LARM inference audit records
After=local-fs.target

[Service]
Type=oneshot
User=ugnoguchi
Group=ugnoguchi
WorkingDirectory=/srv/ai/apps/larm-current
Environment=HOME=/srv/ai/cache
Environment=XDG_CACHE_HOME=/srv/ai/cache
Environment=LARM_INFERENCE_AUDIT_ROOT=/var/lib/larm/inference-audit
Environment=LARM_INFERENCE_AUDIT_KEY_FILE=/etc/larm/inference-audit.key
Environment=LARM_INFERENCE_AUDIT_RETENTION_SECONDS=604800
Environment=LARM_INFERENCE_AUDIT_MAX_BYTES=10737418240
Environment=LARM_INFERENCE_AUDIT_MIN_FREE_BYTES=21474836480
Environment=LARM_INFERENCE_AUDIT_MAX_RESPONSE_BYTES=16777216
EnvironmentFile=-/etc/larm/inference-audit.env
ExecStart=/home/ugnoguchi/.bun/bin/bun run /srv/ai/apps/larm-current/apps/daemon/src/inference-audit-cli.ts prune

NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectHome=read-only
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
LimitCORE=0
ReadOnlyPaths=/srv/ai/apps/larm-current /etc/larm/inference-audit.key
ReadWritePaths=/srv/ai/cache /var/lib/larm
UMask=0077
