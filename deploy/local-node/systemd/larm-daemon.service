[Unit]
Description=LARM local AI runtime control plane
After=llama-server.service llama-swap-worker.service
Wants=llama-server.service llama-swap-worker.service

[Service]
Type=simple
User=ugnoguchi
Group=ugnoguchi
WorkingDirectory=/srv/ai/apps/larm-current
Environment=HOME=/srv/ai/cache
Environment=XDG_CACHE_HOME=/srv/ai/cache
Environment=LARM_HOST=0.0.0.0
Environment=LARM_PORT=9810
Environment=LARM_GATEWAY_TIMEOUT_SECONDS=3300
Environment=LARM_CONNECTION_READY_TIMEOUT_SECONDS=300
Environment=LARM_ALLOW_ANONYMOUS_AGENT_CONNECTIONS=true
Environment=LARM_SERVICE_HARNESS_AUTH_ENABLED=false
Environment=LARM_CONTEXT_ENABLED=true
Environment=LARM_PERSONAL_STATE_ENABLED=false
Environment=LARM_PERSONAL_STATE_JOURNAL_ROOT=/var/lib/larm/personal-state
Environment=LARM_CONTEXT_METADATA_ROOT=/var/lib/larm/contexts
Environment=LARM_CONTEXT_SOURCE_ROOT=/srv/ai/context-sources
Environment=LARM_CONTEXT_SOURCE_MAX_TOTAL_BYTES=549755813888
Environment=LARM_RELEASE_MANIFEST=/srv/ai/apps/larm-current/release-manifest.json
Environment=LARM_ARTIFACT_STAGING_ROOT=/srv/ai/models/.larm-staging
Environment=LARM_ARTIFACT_ROLLBACK_ROOT=/srv/ai/models/.larm-rollback
Environment=LARM_ARTIFACT_STATE_ROOT=/var/lib/larm
Environment=LARM_INFERENCE_AUDIT_MODE=full-required
Environment=LARM_INFERENCE_AUDIT_ROOT=/var/lib/larm/inference-audit
Environment=LARM_INFERENCE_AUDIT_KEY_FILE=/etc/larm/inference-audit.key
Environment=LARM_INFERENCE_AUDIT_RETENTION_SECONDS=604800
Environment=LARM_INFERENCE_AUDIT_MAX_BYTES=10737418240
Environment=LARM_INFERENCE_AUDIT_MIN_FREE_BYTES=21474836480
Environment=LARM_INFERENCE_AUDIT_MAX_RESPONSE_BYTES=16777216
EnvironmentFile=/etc/larm/larm.env
EnvironmentFile=-/etc/larm/inference-audit.env
ExecStart=/home/ugnoguchi/.bun/bin/bun run /srv/ai/apps/larm-current/apps/daemon/src/main.ts
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=360
KillSignal=SIGTERM
LimitNOFILE=65535
LimitCORE=0
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadOnlyPaths=/srv/ai/apps/larm-current
ReadWritePaths=/srv/ai/cache /srv/ai/context-sources /srv/ai/logs /srv/ai/models /var/lib/larm
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
