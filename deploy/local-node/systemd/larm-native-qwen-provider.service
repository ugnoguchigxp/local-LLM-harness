[Unit]
Description=LARM native Qwen WebSocket Provider
Requires=llama-server.service
After=llama-server.service
PartOf=llama-server.service

[Service]
Type=simple
User=ugnoguchi
Group=ugnoguchi
WorkingDirectory=/srv/ai/apps/q38rocm
Environment=HOME=/srv/ai/cache
Environment=LARM_NATIVE_ENGINE_SOCKET=/run/larm-native-qwen/engine.sock
Environment=LARM_NATIVE_PROVIDER_HOST=127.0.0.1
Environment=LARM_NATIVE_PROVIDER_PORT=8090
Environment=LARM_NATIVE_ENGINE_TIMEOUT_MS=2000
ExecStart=/home/ugnoguchi/.bun/bin/bun run /srv/ai/apps/q38rocm/native-provider/main.ts
Restart=on-failure
RestartSec=2
TimeoutStartSec=10
TimeoutStopSec=10
KillSignal=SIGTERM
LimitNOFILE=4096
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadOnlyPaths=/srv/ai/apps/q38rocm
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
