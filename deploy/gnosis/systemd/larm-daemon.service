[Unit]
Description=LARM local AI runtime control plane
After=network-online.target llama-server.service llama-swap-worker.service
Wants=network-online.target llama-server.service llama-swap-worker.service

[Service]
Type=simple
User=ugnoguchi
Group=ugnoguchi
WorkingDirectory=/srv/ai/apps/larm-current
Environment=HOME=/srv/ai/cache
Environment=XDG_CACHE_HOME=/srv/ai/cache
Environment=LARM_HOST=0.0.0.0
Environment=LARM_PORT=9810
Environment=LARM_RELEASE_MANIFEST=/srv/ai/apps/larm-current/release-manifest.json
Environment=LARM_ARTIFACT_STAGING_ROOT=/srv/ai/models/.larm-staging
Environment=LARM_ARTIFACT_ROLLBACK_ROOT=/srv/ai/models/.larm-rollback
Environment=LARM_ARTIFACT_STATE_ROOT=/var/lib/larm
EnvironmentFile=/etc/larm/larm.env
ExecStart=/home/ugnoguchi/.bun/bin/bun run /srv/ai/apps/larm-current/apps/daemon/src/main.ts
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=360
KillSignal=SIGTERM
LimitNOFILE=65535
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadOnlyPaths=/srv/ai/apps/larm-current
ReadWritePaths=/srv/ai/cache /srv/ai/logs /srv/ai/models/.larm-staging /srv/ai/models/.larm-rollback /srv/ai/models/qwen38-worker /srv/ai/models/qwen36-35b /srv/ai/models/ornith15-35b /srv/ai/models/qwen-tts /var/lib/larm
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
