-CONFIG_PATH = Path.home() / "qwen3-tts" / "config.yaml"
+CONFIG_PATH = Path(
+    os.getenv("TTS_CONFIG", str(Path.home() / "qwen3-tts" / "config.yaml"))
+).expanduser()
+
+
+def install_rocm_multinomial_fallback() -> None:
+    """Sample on CPU to avoid the gfx1151 HIP multinomial failure."""
+    import torch
+
+    if not torch.version.hip or getattr(torch.multinomial, "_gfx1151_fallback", False):
+        return
+
+    native_multinomial = torch.multinomial
+
+    def cpu_multinomial(
+        probabilities,
+        num_samples,
+        replacement=False,
+        *,
+        generator=None,
+        out=None,
+    ):
+        if probabilities.device.type != "cuda":
+            return native_multinomial(
+                probabilities,
+                num_samples,
+                replacement=replacement,
+                generator=generator,
+                out=out,
+            )
+        sampled = native_multinomial(
+            probabilities.float().cpu(),
+            num_samples,
+            replacement=replacement,
+        ).to(probabilities.device)
+        if out is not None:
+            out.copy_(sampled)
+            return out
+        return sampled
+
+    cpu_multinomial._gfx1151_fallback = True
+    torch.multinomial = cpu_multinomial
 
 def load_config() -> dict:
     if CONFIG_PATH.exists():
